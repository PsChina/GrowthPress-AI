.venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.DS_Store
.env
data/runs.db
data/runs.db-shm
data/runs.db-wal
data/daemon.pid
# daemon 派工给 claude subprocess 的逐次跑日志 (prompt + stdout + stderr)
logs/
data/drafts/*.md
!data/drafts/.gitkeep
# Claude 工作流下载的图片素材 (跑一次发一次, 不入 git)
data/test-images/
data/images/

# 渠道插件: 默认全 ignore. 公开渠道按需在下方白名单解除.
/plugins/*
!/plugins/.gitkeep
# !/plugins/<public-channel-name>/    ← 未来公开渠道在此 unignore

# 个人调度配置 (含具体主题), 仓内只放 topics.example.yaml 模板
/config/topics.yaml
