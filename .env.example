# 复制为 .env 并填值. .env 在 .gitignore 里, 不会进 git.

# ===== LLM (m0) — anthropic SDK + Anthropic 协议 =====
# 默认 DeepSeek 接管 Anthropic 协议: web_search server tool 免费 (跟 DeepSeek 套餐计费)
# 切真 Anthropic: 改 LLM_BASE_URL=https://api.anthropic.com + LLM_API_KEY=sk-ant-... + LLM_MODEL=claude-sonnet-4-5
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/anthropic
LLM_MODEL=deepseek-v4-pro[1m]

# ===== 邮件 (m3/m4/m5, W3 实施时填) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=                                 # Gmail App Password (不是登录密码)

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX

# 审核员邮箱 (APV / REJECT / PUB / 日报 都发到这里, 通常跟 SMTP_USER 相同)
NOTIFY_TO=
