# 复制为 .env 并填值. .env 在 .gitignore 里, 不会进 git.
# 配置由 m0 core/settings.py (pydantic-settings) 读取.

# ===== LLM (m0 core/llm_client.py 统一 client + provider switch) =====
# 默认 DeepSeek (省钱). base_url 可切到 Anthropic 官方 OpenAI 兼容端点切换 provider.
LLM_PROVIDER=deepseek                      # deepseek | anthropic
LLM_API_KEY=                               # DeepSeek sk-... 或 Anthropic sk-ant-...
LLM_BASE_URL=https://api.deepseek.com      # 切 https://api.anthropic.com/v1 走 Anthropic
LLM_MODEL=deepseek-chat                    # 或 claude-sonnet-4-5

# ===== 邮件 (m3 approver + m4 publisher 通知 + m5 mailbox poller) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=                                 # Gmail App Password (不是登录密码)

IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX

NOTIFY_TO=your-email@example.com         # 审核员邮箱
